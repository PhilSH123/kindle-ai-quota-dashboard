{
  "outputDir": "state",
  "keepLocalHistory": false,
  "quoteFile": "config/quote.json",
  "weatherFile": "config/weather.json",
  "weatherLocation": { "name": "石家庄", "latitude": 38.04139, "longitude": 114.47861 },
  "providers": {
    "deepseek": {
      "enabled": true,
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "glm": {
      "enabled": true,
      "apiKeyEnv": "GLM_CODING_API_KEY"
    },
    "claude": {
      "enabled": false,
      "experimental": true,
      "allowLocalCredentialRead": false,
      "credentialsFile": "~/.claude/.credentials.json"
    },
    "codex": {
      "enabled": true,
      "experimental": true,
      "executableEnv": "CODEX_CLI_PATH"
    },
    "kimi": {
      "enabled": false,
      "experimental": true,
      "allowLocalCredentialRead": false,
      "credentialsFile": "~/.kimi-code/credentials/kimi-code.json",
      "baseUrl": "https://api.kimi.com/coding/v1"
    }
  }
}
